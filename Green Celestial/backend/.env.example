# MongoDB connection URL
# Replace with your production MongoDB Atlas connection string or local Mongo URL
URL=mongodb://localhost:27017/greencelestial

# Server port
PORT=8000

# Public backend URL (set this to your deployed backend address, e.g. https://api.yourdomain.com)
# Used by server policies and by frontend when needed
BACKEND_URL=http://localhost:8000

# Example: add any other backend secrets here (JWT_SECRET, CLOUDINARY_URL, etc.)
# JWT_SECRET=your_jwt_secret_here
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
